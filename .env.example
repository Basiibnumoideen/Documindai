# ==============================================================================
# DocuMind AI — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the values below with your own keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Key (Required)
# ------------------------------------------------------------------------------
# Used for generating dense vector embeddings (gemini-embedding-001)
# and synthesizing grounded document answers (gemini-3.5-flash).
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration (Recommended)
# ------------------------------------------------------------------------------
# Used for storing and querying 768-dimensional vector embeddings with pgvector.
# Obtain these from your Supabase Dashboard -> Project Settings -> API.
#
# (Note: If Supabase keys are left empty, DocuMind AI will automatically use
# its built-in local vector fallback store at .data/chunks.json).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (Server-side bypass for RLS)
# Keep this secret — never expose it in public client code!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
